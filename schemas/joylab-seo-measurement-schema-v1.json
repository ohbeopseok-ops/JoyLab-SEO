{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JOYLAB SEO Measurement Manifest V1",
  "type": "object",
  "required": [
    "content_id","url","page_type","parent_hub","primary_entity","primary_intent",
    "published_at","baseline_at","d7_check_at","d14_measure_at","d30_decision_at",
    "gold_status","decision"
  ],
  "properties": {
    "content_id":{"type":"string"},
    "url":{"type":"string"},
    "slug":{"type":"string"},
    "page_type":{"type":"string","enum":["HOME","HUB","PILLAR","CLUSTER","RESEARCH","BOOK","LEADERSHIP","AI_PRODUCTIVITY","TOOL","NEWS_ANALYSIS"]},
    "parent_hub":{"type":"string"},
    "primary_entity":{"type":"string"},
    "primary_intent":{"type":"string"},
    "target_query_cluster":{"type":"array","items":{"type":"string"}},
    "published_at":{"type":"string"},
    "updated_at":{"type":["string","null"]},
    "baseline_at":{"type":"string"},
    "d7_check_at":{"type":"string"},
    "d14_measure_at":{"type":"string"},
    "d30_decision_at":{"type":"string"},
    "google_indexed":{"type":["boolean","null"]},
    "naver_indexed":{"type":["boolean","null"]},
    "canonical_ok":{"type":["boolean","null"]},
    "sitemap_included":{"type":["boolean","null"]},
    "crawler_visible":{"type":["boolean","null"]},
    "schema_valid":{"type":["boolean","null"]},
    "impressions":{"type":["integer","null"],"minimum":0},
    "clicks":{"type":["integer","null"],"minimum":0},
    "ctr":{"type":["number","null"],"minimum":0},
    "avg_position":{"type":["number","null"],"minimum":0},
    "target_query_match_rate":{"type":["number","null"],"minimum":0,"maximum":100},
    "internal_links_in":{"type":["integer","null"],"minimum":0},
    "internal_links_out":{"type":["integer","null"],"minimum":0},
    "related_nodes":{"type":"array","items":{"type":"string"}},
    "framework_node":{"type":["string","null"]},
    "evidence_nodes":{"type":"array","items":{"type":"string"}},
    "ai_citation_observed":{"type":["boolean","null"]},
    "ai_citation_engines":{"type":"array","items":{"type":"string"}},
    "citation_ready_block_present":{"type":["boolean","null"]},
    "gold_status":{"type":"string","enum":["GOLD","HOLD","RED"]},
    "decision":{"type":"string","enum":["keep","expand","revise","merge","retire","pending"]},
    "owner":{"type":["string","null"]},
    "notes":{"type":["string","null"]}
  }
}